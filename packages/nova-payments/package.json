{
  "name": "@tuwaio/nova-payments",
  "version": "0.0.0",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L7 payments package of Nova UI Kit (TUWA): the checkout of Quasar Payments invoices, with crypto payments from a wallet or a QR code, in a modal, inline or on a page.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js",
      "require": "./dist/i18n/index.cjs"
    },
    "./evm": {
      "types": "./dist/evm/index.d.ts",
      "import": "./dist/evm/index.js",
      "require": "./dist/evm/index.cjs"
    },
    "./solana": {
      "types": "./dist/solana/index.d.ts",
      "import": "./dist/solana/index.js",
      "require": "./dist/solana/index.cjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "build": "tsup && pnpm exec postcss ./src/styles/app.css -o ./dist/index.css",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "web3",
    "payments",
    "checkout",
    "crypto-payments",
    "stablecoins",
    "invoice",
    "quasar",
    "ui",
    "components",
    "tailwind",
    "i18n",
    "accessibility",
    "nova",
    "tuwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/quasar-client.git",
    "directory": "packages/nova-payments"
  },
  "homepage": "https://github.com/TuwaIO/quasar-client",
  "bugs": {
    "url": "https://github.com/TuwaIO/quasar-client/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@heroicons/react": "2.x.x",
    "@solana-program/system": ">=0.15",
    "@solana-program/token": ">=0.17",
    "@solana/kit": ">=8.2",
    "@tuwaio/nova-connect": ">=0.13",
    "@tuwaio/nova-core": ">=0.13",
    "@tuwaio/nova-transactions": ">=0.13",
    "@tuwaio/orbit-core": ">=0.6.2",
    "@tuwaio/orbit-solana": ">=0.5",
    "@tuwaio/pulsar-core": ">=0.12",
    "@tuwaio/quasar-sdk": ">=0.8.0",
    "@tuwaio/satellite-core": ">=0.12",
    "@tuwaio/satellite-react": ">=0.10",
    "@wagmi/core": "3.x.x",
    "framer-motion": "12.x.x || 13.x.x || 14.x.x",
    "react": ">=19.2.3",
    "viem": "2.x.x",
    "zustand": "5.x.x"
  },
  "peerDependenciesMeta": {
    "@solana-program/system": {
      "optional": true
    },
    "@solana-program/token": {
