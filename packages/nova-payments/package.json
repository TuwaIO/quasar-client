    "@radix-ui/react-dialog": "^1.3.1",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tuwaio/nova-connect": "^0.13.0",
    "@tuwaio/nova-core": "^0.13.0",
    "@tuwaio/nova-transactions": "^0.13.1",
    "@tuwaio/orbit-core": "^0.6.2",
    "@tuwaio/orbit-solana": "^0.7.4",
    "@tuwaio/pulsar-core": "^0.12.4",
    "@tuwaio/quasar-sdk": "workspace:^",
    "@tuwaio/satellite-core": "^0.12.0",
    "@tuwaio/satellite-react": "^0.10.4",
    "@types/react": "^19.3.0",
    "@wagmi/core": "^3.6.7",
    "@web3icons/common": "^0.11.53",
