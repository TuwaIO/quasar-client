    "postcss-cli": "^12.0.0",
    "react": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "viem": "^2.57.13",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  }
}
