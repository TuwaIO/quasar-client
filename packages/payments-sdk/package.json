{
  "name": "@tuwaio/payments-sdk",
  "version": "0.0.1",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L10 Payments module of the TUWA SDK: the Nova Payments checkout and the Quasar checkout client, on top of @tuwaio/sdk.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "require": "./dist/i18n.cjs"
    },
    "./evm": {
      "types": "./dist/evm.d.ts",
      "import": "./dist/evm.js",
      "require": "./dist/evm.cjs"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "import": "./dist/solana.js",
      "require": "./dist/solana.cjs"
    },
    "./checkout": {
      "types": "./dist/checkout.d.ts",
      "import": "./dist/checkout.js",
      "require": "./dist/checkout.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "build": "tsup && node scripts/through-the-sdk.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "web3",
    "payments",
    "checkout",
    "crypto-payments",
    "stablecoins",
    "quasar",
    "nova",
    "sdk",
    "tuwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/quasar-client.git",
    "directory": "packages/payments-sdk"
  },
  "homepage": "https://github.com/TuwaIO/quasar-client",
  "bugs": {
    "url": "https://github.com/TuwaIO/quasar-client/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@solana-program/system": ">=0.15",
    "@solana-program/token": ">=0.17",
    "@solana/kit": ">=8.2",
    "@tuwaio/sdk": ">=0.9",
    "@tuwaio/solana-sdk": ">=0.7",
    "@wagmi/core": "3.x.x",
    "react": ">=19.2.3",
    "viem": "2.x.x"
  },
  "peerDependenciesMeta": {
    "@solana-program/system": {
      "optional": true
    },
    "@solana-program/token": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "@tuwaio/solana-sdk": {
      "optional": true
    },
    "@wagmi/core": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "dependencies": {
    "framer-motion": "14.9.1",
    "ofetch": "^1.5.1",
    "uqr": "^0.1.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.5.0",
    "@tuwaio/nova-connect": "^0.15.0",
    "@tuwaio/nova-core": "^0.15.1",
    "@tuwaio/nova-payments": "workspace:^",
    "@tuwaio/nova-transactions": "^0.15.1",
    "@tuwaio/orbit-core": "^0.6.2",
    "@tuwaio/orbit-solana": "^0.7.4",
    "@tuwaio/pulsar-core": "^0.12.4",
    "@tuwaio/quasar-sdk": "workspace:^",
    "@tuwaio/satellite-core": "^0.12.0",
    "@tuwaio/satellite-react": "^0.10.4",
    "@tuwaio/sdk": "^0.9.1",
    "@tuwaio/solana-sdk": "^0.7.1",
    "@types/react": "^19.3.0",
    "@wagmi/core": "^3.6.7",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "viem": "^2.57.13",
    "vitest": "^5.0.5"
  }
}
